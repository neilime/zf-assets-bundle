{
    "name": "neilime/zf-assets-bundle",
    "type": "library",
    "description": "Laminas MVC module that provides asset bundling and caching",
    "keywords": [
        "assets",
        "assets-management",
        "bundle",
        "cache",
        "minify",
        "css",
        "js",
        "less",
        "scss",
        "laminas"
    ],
    "homepage": "http://neilime.github.io/zf-assets-bundle/",
    "license": "MIT",
    "authors": [
        {
            "name": "Neilime",
            "homepage": "https://github.com/neilime",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/neilime/zf-assets-bundle/issues"
    },
    "minimum-stability": "stable",
    "suggest": {
        "tedivm/jshrink": "Javascript Minifier, used by JShrinkAssetFileFilter",
        "mrclay/jsmin-php": "Port of Douglas Crockford's jsmin.c, used by JsMinAssetFileFilter",
        "tubalmartin/cssmin": "PHP port of the YUI CSS compressor, used by CssAssetFileFilter",
        "ext-gd": "Compress PNG files",
        "scssphp/scssphp": "Compile SCSS assets",
        "wikimedia/less.php": "Compile Less assets"
    },
    "require": {
        "laminas/laminas-cli": "^1.16.0",
        "laminas/laminas-config": "^3.11.0",
        "laminas/laminas-eventmanager": "^3.16.0",
        "laminas/laminas-http": "^2.23.0",
        "laminas/laminas-modulemanager": "^2.19.0",
        "laminas/laminas-mvc": "^3.8.0",
        "laminas/laminas-servicemanager": "^3.24.0",
        "laminas/laminas-view": "^2.44.0",
        "php": "~8.4.0",
        "symfony/console": "^7.4"
    },
    "require-dev": {
        "laminas/laminas-test": "^4.12.0",
        "mrclay/jsmin-php": "^2.4",
        "phpunit/phpunit": "^12.5.44",
        "scssphp/scssphp": "^2.1.0",
        "tedivm/jshrink": "^1.8",
        "tubalmartin/cssmin": "^4.1",
        "wikimedia/less.php": "^5.5.1"
    },
    "autoload": {
        "psr-4": {
            "AssetsBundle\\": "src/AssetsBundle"
        },
        "classmap": [
            "Module.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "AssetsBundleTest\\": "tests/AssetsBundleTest/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration tests/phpunit.xml",
        "test:ci": "@test --log-junit build/junit.xml --coverage-cobertura build/cobertura.xml",
        "lint": [
            "@composer validate --strict",
            "find src config tests/AssetsBundleTest -name '*.php' -print0 | xargs -0 -n1 php -l",
            "@php -l Module.php"
        ],
        "lint:ci": "@lint"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laminas": {
            "component": "AssetsBundle"
        }
    }
}
